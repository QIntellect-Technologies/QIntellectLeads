# Copy to .dev.vars for local development with real Sign in with Freebuff.
# Get these from `sites_enable_auth` (development variables) or
# `npx @freebuff/auth register --environment development ...`.
# Without them the app runs with a local development user on localhost only.
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=https://freebuff.com/oidc
APP_ORIGIN=http://localhost:5173

# Optional SMTP fallback. You can instead save the app password in
# Settings -> Email briefings, where it is encrypted in D1.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@qintellecttechnologies.com
SMTP_PASSWORD=
SMTP_FROM=admin@qintellecttechnologies.com
EMAIL_TO=admin@qintellecttechnologies.com
